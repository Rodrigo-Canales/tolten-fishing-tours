---
// Juncos y piedras del fondo del río, en silueta.
interface Props { class?: string; semilla?: number }
const { class: c = '', semilla = 1 } = Astro.props;
let s = semilla * 7919;
const rnd = () => ((s = (s * 16807) % 2147483647) / 2147483647);
const hojas = Array.from({ length: 34 }, (_, i) => {
  const x = (i / 26) * 1000 + rnd() * 30;
  const h = 70 + rnd() * 110;
  const curva = (rnd() - 0.5) * 70;
  const w = 5 + rnd() * 5;
  return { d: `M${x - w} 400 Q${x + curva * 0.4} ${400 - h * 0.55} ${x + curva} ${400 - h} Q${x + curva * 0.4 + w * 0.6} ${400 - h * 0.55} ${x + w} 400Z`, o: 0.55 + rnd() * 0.45, dl: rnd() * 4 };
});
const piedras = Array.from({ length: 9 }, () => ({ cx: rnd() * 1000, rx: 50 + rnd() * 90, ry: 22 + rnd() * 30 }));
---
<svg viewBox="0 0 1000 400" preserveAspectRatio="xMidYMax slice" class={c} style="overflow: visible" aria-hidden="true">
  <defs>
    <linearGradient id={`j${semilla}`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2c5a3e" /><stop offset="1" stop-color="#081a14" /></linearGradient>
  </defs>
  {hojas.map((h) => <path d={h.d} fill={`url(#j${semilla})`} opacity={h.o} class="junco" style={`animation-delay:-${h.dl}s`} />)}
  {piedras.map((p) => <ellipse cx={p.cx} cy={400} rx={p.rx} ry={p.ry} fill="#06120f" />)}
</svg>
<style>
  .junco { transform-box: fill-box; transform-origin: bottom center; animation: ondea 5s ease-in-out infinite alternate; }
  @keyframes ondea { from { transform: skewX(-4deg); } to { transform: skewX(4deg); } }
  @media (prefers-reduced-motion: reduce) { .junco { animation: none; } }
</style>
