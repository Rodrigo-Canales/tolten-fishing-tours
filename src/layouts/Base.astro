---
import '../styles/global.css';
import sitio from '../data/sitio.json';
import Icono from '../components/Icono.astro';
import { wa } from '../lib/util';

interface Props { titulo?: string; descripcion?: string; inicio?: boolean }
const {
  titulo = `${sitio.nombre} | Pesca guiada en el río Toltén`,
  descripcion = `Pesca guiada con mosca y spinning en el río Toltén, Mahuidanche y afluentes exclusivos, ${sitio.region}. Trucha arcoíris, trucha café y salmón chinook.`,
  inicio = false,
} = Astro.props;
const h = (id: string) => (inicio ? `#${id}` : `/#${id}`);
const links = [
  { t: 'Especies', href: h('especies') },
  { t: 'Programas', href: inicio ? '#programas' : '/programas' },
  { t: 'El río', href: h('rios') },
  { t: 'Salidas', href: h('salidas') },
  { t: 'Preguntas', href: h('preguntas') },
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#061416" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header id="barra" class="gutter fixed inset-x-0 top-0 z-50 transition-[background,backdrop-filter,border-color] duration-500" style="padding-top: env(safe-area-inset-top, 0px)">
      <nav class="mx-auto flex h-18 max-w-7xl items-center justify-between gap-6" aria-label="Principal">
        <a href="/" class="flex flex-col leading-none" aria-label={`${sitio.nombre}, inicio`} >
          <span class="titulo text-2xl text-espuma md:text-[1.7rem]">Toltén</span>
          <span class="mt-0.5 text-[0.6rem] font-bold tracking-[0.42em] text-ambar">FISHING TOURS</span>
        </a>
        <ul class="hidden items-center gap-8 text-sm font-semibold text-espuma/80 lg:flex">
          {links.map((l) => <li><a href={l.href} class="transition-colors hover:text-ambar">{l.t}</a></li>)}
        </ul>
        <div class="flex items-center gap-2">
          <a href={h('reservar')} class="boton boton-ambar hidden !min-h-10 !px-5 text-sm sm:inline-flex">Reservar salida</a>
          <button id="abrir-menu" class="grid size-11 place-items-center rounded-full border border-espuma/25 text-espuma lg:hidden" aria-label="Abrir menú" aria-expanded="false" aria-controls="menu-movil">
            <Icono n="menu" class="size-6" />
          </button>
        </div>
      </nav>
    </header>

    <div id="menu-movil" class="gutter fixed inset-0 z-[55] hidden flex-col bg-abismo/97 pb-10 backdrop-blur-xl" style="padding-top: calc(env(safe-area-inset-top, 0px) + 1rem)">
      <div class="flex h-14 items-center justify-between">
        <span class="titulo text-2xl">Toltén <span class="text-ambar">Fishing Tours</span></span>
        <button id="cerrar-menu" class="grid size-11 place-items-center rounded-full border border-espuma/25 text-espuma" aria-label="Cerrar menú"><Icono n="cerrar" class="size-6" /></button>
      </div>
      <ul class="mt-10 flex flex-col gap-2">
        {links.map((l) => <li><a href={l.href} class="cerrar-al-tocar block py-3 titulo text-5xl text-espuma">{l.t}</a></li>)}
      </ul>
      <div class="mt-auto grid gap-3">
        <a href={h('reservar')} class="cerrar-al-tocar boton boton-ambar w-full">Reservar salida</a>
        <a href={wa('Hola, quiero consultar por una salida de pesca')} target="_blank" rel="noopener" class="boton boton-linea w-full"><Icono n="whatsapp" /> Escribir por WhatsApp</a>
      </div>
    </div>

    <slot />

    <footer class="gutter relative border-t border-niebla/15 bg-rio pt-16 pb-10">
      <div class="mx-auto grid max-w-7xl gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
        <div>
          <p class="titulo text-5xl">Toltén</p>
          <p class="mt-1 text-xs font-bold tracking-[0.42em] text-ambar">FISHING TOURS</p>
          <p class="mt-6 max-w-sm text-niebla">{sitio.eslogan}. {sitio.region}.</p>
        </div>
        <div>
          <p class="acento text-2xl text-ambar">Temporada</p>
          <p class="mt-3 text-sm text-niebla">{sitio.temporada}.</p>
          <p class="mt-3 text-sm text-niebla">Captura y suelta en todas nuestras salidas.</p>
        </div>
        <div>
          <p class="acento text-2xl text-ambar">Contacto</p>
          <div class="mt-4 flex flex-col gap-3 text-sm">
            <a href={sitio.instagram} target="_blank" rel="noopener" class="flex items-center gap-3 hover:text-ambar"><Icono n="instagram" /> @toltenfishingtours</a>
            <a href={wa('Hola, quiero consultar por una salida de pesca')} target="_blank" rel="noopener" class="flex items-center gap-3 hover:text-ambar"><Icono n="whatsapp" /> {sitio.telefonoVisible}</a>
            <span class="flex items-center gap-3 text-niebla"><Icono n="pin" /> Río Toltén, {sitio.region}</span>
          </div>
        </div>
      </div>
      <div class="mx-auto mt-14 flex max-w-7xl flex-col gap-3 border-t border-niebla/10 pt-6 text-xs text-niebla/70 sm:flex-row sm:justify-between">
        <p>© {new Date().getFullYear()} {sitio.nombre}. Pesca con licencia vigente de Sernapesca.</p>
        <p>Sitio por <a href="https://infinode.cl" target="_blank" rel="noopener" class="text-ambar hover:underline">Infinode</a></p>
      </div>
      <p class="mx-auto mt-4 max-w-7xl text-[0.7rem] leading-relaxed text-niebla/50">Fotos de peces: Wikimedia Commons, dominio público (USFWS, U.S. FDA). Puente sobre el Toltén en Pitrufquén: EL GUILLE! (CC BY 2.0). Río Toltén: Maxbalter (CC BY-SA 3.0). Todas vía Wikimedia Commons. Mapa: © colaboradores de OpenStreetMap.</p>
    </footer>

    <script>
      import Lenis from 'lenis';
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      import { SplitText } from 'gsap/SplitText';
      gsap.registerPlugin(ScrollTrigger, SplitText);

      const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!quieto) {
        const lenis = new Lenis({ lerp: 0.09, anchors: { offset: -72 } });
        lenis.on('scroll', ScrollTrigger.update);
        gsap.ticker.add((t) => lenis.raf(t * 1000));
        gsap.ticker.lagSmoothing(0);
        (window as any).lenis = lenis;
      }

      const barra = document.getElementById('barra')!;
      const pintar = () => {
        const s = scrollY > 40;
        barra.style.background = s ? 'rgb(6 20 22 / 0.8)' : 'transparent';
        barra.style.backdropFilter = s ? 'blur(14px)' : 'none';
        barra.style.borderBottom = s ? '1px solid rgb(157 181 173 / 0.14)' : '1px solid transparent';
      };
      pintar();
      addEventListener('scroll', pintar, { passive: true });

      const menu = document.getElementById('menu-movil')!;
      const abrir = document.getElementById('abrir-menu')!;
      const cerrar = () => { menu.classList.add('hidden'); menu.classList.remove('flex'); abrir.setAttribute('aria-expanded', 'false'); (window as any).lenis?.start(); };
      abrir.addEventListener('click', () => { menu.classList.remove('hidden'); menu.classList.add('flex'); abrir.setAttribute('aria-expanded', 'true'); (window as any).lenis?.stop(); });
      document.getElementById('cerrar-menu')!.addEventListener('click', cerrar);
      menu.querySelectorAll('.cerrar-al-tocar').forEach((a) => a.addEventListener('click', cerrar));
      addEventListener('keydown', (e) => e.key === 'Escape' && cerrar());

      // Títulos: cada línea sube desde detrás de una máscara al entrar en pantalla
      if (!quieto) {
        document.fonts.ready.then(() => {
          gsap.utils.toArray<HTMLElement>('[data-titulo]').forEach((el) => {
            const sp = SplitText.create(el, { type: 'lines', mask: 'lines', linesClass: 'linea-titulo' });
            gsap.from(sp.lines, { yPercent: 105, duration: 1.1, stagger: 0.09, ease: 'power4.out', scrollTrigger: { trigger: el, start: 'top 88%' } });
          });
        });
      }
    </script>
  </body>
</html>
